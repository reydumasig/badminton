# --------------------------------------------------------------
# Dizer Badminton Academy – Environment Variables
# --------------------------------------------------------------
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# --------------------------------------------------------------

# Resend – email notifications (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ACADEMY_EMAIL=hello@dizerbadmintonacademy.com

# Supabase – server-side DB access (Settings → API)
# Use the SERVICE ROLE key here (bypasses RLS)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase – client-side auth (Settings → API)
# Use the ANON / PUBLIC key here (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin dashboard password
ADMIN_PASSWORD=your-strong-password

# Vercel Cron secret – protects the /api/cron/reminders endpoint
# Generate any random string: openssl rand -hex 32
CRON_SECRET=your-cron-secret
