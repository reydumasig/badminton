# --------------------------------------------------------------
# Dizer Badminton Academy – Environment Variables
# --------------------------------------------------------------
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# --------------------------------------------------------------

# Resend API key for sending email notifications
# Sign up at https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The email address where form submissions will be delivered
ACADEMY_EMAIL=hello@dizerbadmintonacademy.com

# Supabase — get these from your project at https://supabase.com
# Settings → API → Project URL and Service Role Key
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
